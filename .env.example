# --- Supabase (Postgres + Storage + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesión (login) ---
# Secreto para firmar la cookie de sesión. Opcional: si se deja vacío se usa
# SUPABASE_SERVICE_ROLE_KEY. En producción, poné una cadena larga y aleatoria.
AUTH_SECRET=

# --- Groq (transcripcion de audio, Whisper) ---
# Gratis en console.groq.com. Convierte el audio de campo en texto (español).
GROQ_API_KEY=
# Opcional: modelo de transcripcion (por defecto whisper-large-v3)
# GROQ_MODELO_STT=whisper-large-v3

# --- Anthropic (procesamiento de audio/texto al sincronizar) ---
# Modelos: claude-sonnet-4-6 (extraccion estructurada) y claude-haiku-4-5 (clasificaciones simples)
ANTHROPIC_API_KEY=
